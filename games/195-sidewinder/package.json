{
  "name": "sidewinder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "響尾蛇越野 · SIDEWINDER：致敬 Super Off-Road 的俯視角越野卡車賽（作品 195）",
  "scripts": {
    "build": "node tools/build.mjs",
    "assets": "blender -b --factory-startup --python blender/build_all.py -- --out blender/out",
    "test:core": "cd core && cargo test",
    "test": "node tools/playtest.mjs",
    "shot": "node tools/shot.mjs",
    "check": "node tools/check-assets.mjs",
    "sim": "node tools/sim.mjs",
    "deploy:dist": "node tools/build.mjs --out=dist",
    "deploy": "npm run deploy:dist && npx wrangler pages deploy dist --project-name sidewinder"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.12.0"
  },
  "engines": {
    "node": ">=22"
  }
}
