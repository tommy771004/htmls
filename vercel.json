{
  "headers": [
    {
      "source": "/assets/282/:path((?!manifest\\.json$).*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    },
    {
      "source": "/assets/282/manifest.json",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=3600" }]
    }
  ],
  "rewrites": [
    { "source": "/api/ro/:path*", "destination": "/api/ro?__path=:path*" }
  ],
  "redirects": [
    { "source": "/web/200-carball.html", "destination": "/web/200-roadster-arena.html", "permanent": true },
    { "source": "/200-carball.html", "destination": "/web/200-roadster-arena.html", "permanent": true },
    { "source": "/:file(\\d{3}-[a-z0-9-]+\\.html)", "destination": "/web/:file", "permanent": true }
  ]
}
